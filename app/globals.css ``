:root {
  --orange-50: #fff7ed;
  --orange-100: #ffedd5;
  --orange-200: #fed7aa;
  --orange-400: #fb923c;
  --orange-500: #f97316;
  --orange-600: #ea580c;
  --orange-700: #c2410c;

  --stone-50: #fafaf9;
  --stone-100: #f5f5f4;
  --stone-200: #e7e5e4;
  --stone-400: #a8a29e;
  --stone-500: #78716c;
  --stone-600: #57534e;
  --stone-800: #292524;
  --stone-900: #1c1917;
  --black: #0c0a09;
  --white: #ffffff;

  --green: #34d399;
  --red: #ef4444;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--stone-900);
  background: #fffaf5;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
input {
  font: inherit;
}

button,
a,
input {
  -webkit-tap-highlight-color: transparent;
}

button {
  border: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

.site {
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 85% 10%,
      rgba(251, 146, 60, 0.14),
      transparent 28rem
    ),
    #fffaf5;
}

.container {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
  padding: 32px 0 42px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 54px;
}

.brand-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  color: var(--orange-700);
  background: var(--orange-100);
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.author {
  margin: 8px 0 0;
  color: var(--stone-500);
  font-size: 14px;
  font-weight: 700;
}

.social-header {
  display: flex;
  gap: 9px;
}

.social-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 15px;
  color: var(--orange-700);
  background: var(--white);
  border: 1px solid var(--orange-200);
  border-radius: 999px;
  box-shadow: 0 5px 16px rgba(234, 88, 12, 0.07);
  font-size: 14px;
  font-weight: 750;
  transition:
    transform 160ms ease,
    background 160ms ease;
}

.social-link:hover {
  background: var(--orange-50);
  transform: translateY(-1px);
}

.hero {
  max-width: 790px;
  margin-bottom: 38px;
}

.hero h1 {
  margin: 0;
  font-size: clamp(42px, 7vw, 72px);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.hero h1 span {
  color: var(--orange-600);
}

.hero p {
  max-width: 680px;
  margin: 22px 0 0;
  color: var(--stone-600);
  font-size: clamp(17px, 2vw, 20px);
  line-height: 1.6;
}

.calculator-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  gap: 24px;
  align-items: stretch;
}

.form-card,
.result-card {
  min-width: 0;
  border-radius: 30px;
}

.form-card {
  padding: 28px;
  background: var(--white);
  border: 1px solid var(--orange-100);
  box-shadow: 0 22px 70px rgba(234, 88, 12, 0.1);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0 0 5px;
  color: var(--orange-600);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.section-heading h2,
.explanation h2 {
  margin: 0;
  font-size: 23px;
  letter-spacing: -0.025em;
}

.reset-button {
  padding: 8px 12px;
  color: var(--stone-500);
  background: var(--stone-100);
  border-radius: 999px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 750;
}

.form-fields {
  display: flex;
  flex-direction: column;
  gap: 17px;
}

.field-row {
  display: grid;
  grid-template-columns: 0.82fr 1.18fr;
  gap: 12px;
}

.field {
  display: block;
  min-width: 0;
}

.field-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 800;
}

.field-label small {
  color: var(--stone-400);
  font-size: 12px;
  font-weight: 650;
}

.required-mark {
  margin-left: 4px;
  color: var(--red);
}

.input-wrapper {
  display: flex;
  align-items: center;
  min-height: 55px;
  padding: 0 15px;
  background: var(--white);
  border: 1px solid var(--stone-200);
  border-radius: 16px;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.input-wrapper:focus-within {
  border-color: var(--orange-500);
  box-shadow: 0 0 0 4px var(--orange-100);
}

.input-prefix {
  color: var(--stone-400);
  font-size: 18px;
  font-weight: 800;
}

.input-wrapper input {
  width: 100%;
  min-width: 0;
  padding: 14px 8px;
  color: var(--stone-900);
  background: transparent;
  border: 0;
  outline: 0;
  font-size: 17px;
  font-weight: 800;
}

.input-wrapper input::placeholder {
  color: #c7c3c0;
  font-weight: 600;
}

.checkbox-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 16px;
  background: var(--stone-50);
  border: 1px solid var(--stone-100);
  border-radius: 17px;
  cursor: pointer;
}

.checkbox-card strong,
.checkbox-card span {
  display: block;
}

.checkbox-card strong {
  margin-bottom: 5px;
  font-size: 14px;
}

.checkbox-card span {
  color: var(--stone-500);
  font-size: 12px;
  line-height: 1.45;
}

.checkbox-card input {
  width: 21px;
  height: 21px;
  flex: 0 0 auto;
  accent-color: var(--orange-600);
}

.required-legend {
  margin: -2px 0 0;
  color: var(--stone-400);
  font-size: 12px;
}

.required-legend span {
  color: var(--red);
}

.calculate-button {
  min-height: 57px;
  padding: 0 20px;
  color: var(--white);
  background: var(--orange-600);
  border-radius: 17px;
  box-shadow: 0 14px 30px rgba(234, 88, 12, 0.24);
  cursor: pointer;
  font-weight: 850;
  transition:
    background 160ms ease,
    transform 160ms ease,
    opacity 160ms ease;
}

.calculate-button:hover:not(:disabled) {
  background: var(--orange-700);
  transform: translateY(-1px);
}

.calculate-button:disabled {
  box-shadow: none;
  cursor: not-allowed;
  opacity: 0.42;
}

.result-card {
  min-height: 590px;
  padding: 30px;
}

.result-card-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--orange-50);
  border: 1px dashed var(--orange-200);
}

.result-card-active {
  color: var(--white);
  background:
    radial-gradient(
      circle at top right,
      rgba(249, 115, 22, 0.24),
      transparent 16rem
    ),
    var(--black);
  box-shadow: 0 26px 70px rgba(28, 25, 23, 0.24);
}

.empty-result {
  max-width: 430px;
  text-align: center;
}

.empty-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 78px;
  height: 78px;
  margin-bottom: 22px;
  color: var(--orange-600);
  background: var(--white);
  border-radius: 50%;
  box-shadow: 0 13px 32px rgba(234, 88, 12, 0.14);
}

.empty-result h2 {
  margin: 0;
  font-size: 27px;
  letter-spacing: -0.03em;
}

.empty-result p {
  margin: 12px 0 0;
  color: var(--stone-600);
  line-height: 1.6;
}

.empty-tip {
  margin-top: 25px;
  padding: 14px 17px;
  color: var(--orange-700);
  background: var(--white);
  border-radius: 15px;
  font-size: 13px;
  font-weight: 750;
}

.result-eyebrow {
  margin: 0 0 15px;
  color: var(--orange-400);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.main-result {
  padding: 22px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 23px;
}

.main-result > span {
  display: block;
  color: #d6d3d1;
  font-size: 14px;
}

.main-result > strong {
  display: block;
  margin-top: 3px;
  color: var(--white);
  font-size: clamp(35px, 6vw, 51px);
  line-height: 1.05;
  letter-spacing: -0.045em;
  overflow-wrap: anywhere;
}

.result-difference {
  margin: 13px 0 0;
  font-size: 17px;
  font-weight: 850;
}

.result-difference.expensive {
  color: var(--orange-400);
}

.result-difference.favorable {
  color: var(--green);
}

.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 13px;
}

.metric {
  padding: 17px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 17px;
}

.metric span,
.metric strong {
  display: block;
}

.metric span {
  min-height: 34px;
  color: var(--stone-400);
  font-size: 12px;
  line-height: 1.4;
}

.metric strong {
  margin-top: 6px;
  font-size: 21px;
  overflow-wrap: anywhere;
}

.annual-rate {
  margin-top: 13px;
  padding: 20px;
  background: rgba(249, 115, 22, 0.11);
  border: 1px solid rgba(251, 146, 60, 0.28);
  border-radius: 19px;
}

.annual-rate span,
.annual-rate strong {
  display: block;
}

.annual-rate span {
  color: #fdba74;
  font-size: 13px;
  font-weight: 750;
}

.annual-rate strong {
  margin-top: 3px;
  color: var(--orange-400);
  font-size: 38px;
  overflow-wrap: anywhere;
}

.annual-rate p {
  margin: 8px 0 0;
  color: var(--stone-400);
  font-size: 11px;
  line-height: 1.5;
}

.human-summary {
  margin: 15px 0;
  padding: 14px 16px;
  color: #e7e5e4;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15px;
  font-size: 13px;
  line-height: 1.55;
}

.human-summary strong {
  color: var(--white);
}

